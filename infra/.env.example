# Copy to infra/.env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=career_radar
POSTGRES_USER=career
POSTGRES_PASSWORD=change-me

# --- Ports ---
# 5433 by default: a locally installed PostgreSQL often owns 5432 already.
POSTGRES_PORT=5433
REDIS_PORT=6379
CORE_API_PORT=8080

# --- core-api <-> collector ---
INTERNAL_TOKEN=change-me

# --- LLM (OpenCode Go, OpenAI-compatible) ---
OPENCODE_GO_BASE_URL=
OPENCODE_GO_API_KEY=

# --- Collector HTTP identity ---
# One honest User-Agent for every career site. Never impersonate a browser.
# Keep a real contact only in infra/.env; .env.example must stay generic.
COLLECTOR_USER_AGENT=CareerRadar/0.1 (personal project; contact: you@example.com)
REQUEST_TIMEOUT=30
RATE_LIMIT_SECONDS=1.0

# --- Company career sites (stage 2) ---
MTS_BASE_URL=https://job.mts.ru
YANDEX_BASE_URL=https://yandex.ru
VK_BASE_URL=https://team.vk.company

# --- hh.ru legacy adapter (not used by the company collector) ---
HH_USER_AGENT=CareerRadar/0.1 (personal project; contact: you@example.com)
HH_BASE_URL=https://api.hh.ru
HH_AREA=1
HH_PER_PAGE=100
# Optional: hh.ru may answer 403 to anonymous /vacancies requests. If your network is
# affected, create an app at https://dev.hh.ru and put its token here.
HH_ACCESS_TOKEN=
