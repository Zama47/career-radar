# Copy to infra/.env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=career_radar
POSTGRES_USER=career
POSTGRES_PASSWORD=change-me

# --- Ports ---
# 5433 by default: a locally installed PostgreSQL often owns 5432 already.
POSTGRES_PORT=5433
REDIS_PORT=6379
CORE_API_PORT=8080

# --- core-api <-> collector ---
INTERNAL_TOKEN=change-me

# --- core-api auth (stage 3) ---
# At least 32 random bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-bytes
JWT_TTL_SECONDS=3600
# Single user. Generate the BCrypt hash: ./gradlew :core-api:hashPassword
APP_USER_EMAIL=you@example.com
APP_USER_PASSWORD_HASH=change-me-to-a-bcrypt-hash

# --- LLM (OpenCode Go, OpenAI-compatible) ---
# Base URL must include the version segment, e.g. https://host/v1.
OPENCODE_GO_BASE_URL=
OPENCODE_GO_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4.1-flash
LLM_WRITING_MODEL=deepseek-v4-pro
LLM_CLASSIFICATION_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CACHE_TTL_HOURS=168
# Optional: USD per 1M tokens. Left at 0 when the provider does not publish prices.
LLM_FLASH_INPUT_PRICE=0
LLM_FLASH_OUTPUT_PRICE=0
LLM_PRO_INPUT_PRICE=0
LLM_PRO_OUTPUT_PRICE=0

# --- Resume PDF storage (local MVP) ---
RESUME_FILES_DIR=./data/resumes
RESUME_MAX_BYTES=10485760

# --- Collector HTTP identity ---
# One honest User-Agent for every career site. Never impersonate a browser.
# Keep a real contact only in infra/.env; .env.example must stay generic.
COLLECTOR_USER_AGENT=CareerRadar/0.1 (personal project; contact: you@example.com)
REQUEST_TIMEOUT=30
RATE_LIMIT_SECONDS=1.0

# --- Company career sites (stage 2) ---
MTS_BASE_URL=https://job.mts.ru
YANDEX_BASE_URL=https://yandex.ru
VK_BASE_URL=https://team.vk.company

# --- hh.ru legacy adapter (not used by the company collector) ---
HH_USER_AGENT=CareerRadar/0.1 (personal project; contact: you@example.com)
HH_BASE_URL=https://api.hh.ru
HH_AREA=1
HH_PER_PAGE=100
# Optional: hh.ru may answer 403 to anonymous /vacancies requests. If your network is
# affected, create an app at https://dev.hh.ru and put its token here.
HH_ACCESS_TOKEN=
